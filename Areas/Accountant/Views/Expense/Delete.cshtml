@model ToyotaWeb.Models.CompanyExpense

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body {
        background: #0f172a;
        color: white;
    }

    .delete-box {
        background: #111827;
        padding: 40px;
        border-radius: 20px;
        max-width: 600px;
        margin: auto;
        margin-top: 80px;
        text-align: center;
    }

    .btn-delete {
        background: #ef4444;
        border: none;
        padding: 12px 22px;
        border-radius: 12px;
        color: white;
        font-weight: 700;
    }
</style>

<div class="delete-box">

    <h2 class="mb-4">
        ⚠ XÓA CHI PHÍ
    </h2>

    <h4 class="mb-4">
        @Model.ExpenseName
    </h4>

    
    <form method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-delete">
            Xác nhận xóa
        </button>

    </form>

</div>