@model ToyotaWeb.Models.CompanyExpense

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body {
        background: #0f172a;
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .form-box {
        max-width: 750px;
        margin: 50px auto;
        background: #111827;
        padding: 40px;
        border-radius: 24px;
        box-shadow: 0 0 35px rgba(0, 0, 0, 0.5);
    }

    .form-box h2 {
        font-size: 40px;
        font-weight: 800;
        margin-bottom: 35px;
    }

    label {
        font-weight: 600;
        margin-bottom: 10px;
        display: block;
        color: #e2e8f0;
    }

    .form-control {
        width: 100%;
        height: 55px;
        border-radius: 14px;
        border: 1px solid #334155;
        background: #1e293b;
        color: white;
        padding: 15px;
        font-size: 16px;
        transition: 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: #22c55e;
        box-shadow: 0 0 12px rgba(34, 197, 94, 0.4);
    }

    .mb-3 {
        margin-bottom: 25px;
    }

    .btn-save {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        border: none;
        color: white;
        padding: 14px 28px;
        border-radius: 14px;
        font-size: 16px;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        opacity: 0.95;
    }
</style>

<div class="form-box">

    <h2>
        ✏️ SỬA CHI PHÍ
    </h2>

    <form action="/Accountant/Expense/Edit" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="mb-3">

            <label>Tên chi phí</label>

            <input name="ExpenseName" value="@Model.ExpenseName" class="form-control" />

        </div>

        <div class="mb-3">

            <label>Danh mục</label>

            <input name="Category" value="@Model.Category" class="form-control" />

        </div>

        <div class="mb-3">

            <label>Số tiền</label>

            <input name="Amount" value="@Model.Amount" type="number" class="form-control" />

        </div>

        <button type="submit" class="btn-save">

            Cập nhật

        </button>

    </form>

</div>