@model ToyotaWeb.Models.Car

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Car";
}

<style>

    body{
        background:#0f172a;
    }

    .edit-wrapper{

        max-width:1400px;
        margin:auto;

        padding:40px;
    }

    .edit-card{

        background:
            linear-gradient(
                145deg,
                #111827,
                #1e293b
            );

        border-radius:30px;

        padding:40px;

        color:white;

        box-shadow:
            0 10px 40px rgba(0,0,0,0.4);
    }

    .page-title{

        font-size:50px;
        font-weight:900;

        margin-bottom:35px;
    }

    .form-label{

        margin-bottom:10px;

        font-weight:700;
    }

    .form-control{

        background:#0f172a;
        border:1px solid rgba(255,255,255,0.08);

        color:white;

        border-radius:14px;

        padding:14px;
    }

    .form-control:focus{

        background:#111827;
        color:white;

        border-color:#38bdf8;

        box-shadow:none;
    }

    .car-preview{

        width:100%;
        height:260px;

        object-fit:cover;

        border-radius:20px;

        margin-top:15px;

        border:3px solid rgba(255,255,255,0.08);
    }

    .save-btn{

        background:
            linear-gradient(
                to right,
                #22c55e,
                #16a34a
            );

        border:none;

        color:white;

        padding:14px 30px;

        border-radius:14px;

        font-weight:700;

        font-size:18px;
    }

    .back-btn{

        background:#334155;

        color:white;

        padding:14px 30px;

        border-radius:14px;

        text-decoration:none;

        margin-left:12px;
    }

</style>

<div class="edit-wrapper">

    <div class="edit-card">

        <h1 class="page-title">
            🚗 Chỉnh sửa xe
        </h1>

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden" asp-for="CarId" />

            <div class="row">

                <!-- LEFT -->

                <div class="col-md-6">

                    <div class="mb-4">

                        <label class="form-label">
                            Tên xe
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Giá bán
                        </label>

                        <input asp-for="Price"
                               class="form-control" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Danh mục
                        </label>

                        <input asp-for="Category"class="form-control" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Kiểu dáng
                        </label>

                        <input asp-for="BodyType"
                               class="form-control" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Số chỗ
                        </label>

                        <input asp-for="Seats"
                               class="form-control" />

                    </div>

                </div>

                <!-- RIGHT -->

                <div class="col-md-6">

                    <div class="mb-4">

                        <label class="form-label">
                            Nhiên liệu
                        </label>

                        <input asp-for="FuelType"
                               class="form-control" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Xuất xứ
                        </label>

                        <input asp-for="Origin"
                               class="form-control" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Mô tả
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"></textarea>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Upload ảnh mới
                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control" />

                    </div>

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             class="car-preview" />
                    }

                    <div class="form-check mt-4">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">

                            Đang hoạt động

                        </label>

                    </div>

                </div>

            </div>

            <div class="mt-5">

                <button type="submit"
                        class="save-btn">

                    💾 Lưu thay đổi

                </button>

                <a asp-action="Index" class="back-btn">← Quay lại

                </a>

            </div>

        </form>

    </div>

</div>