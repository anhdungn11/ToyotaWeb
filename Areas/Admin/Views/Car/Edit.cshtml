@model ToyotaWeb.Models.Car


<h2>Edit Car</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="@Model.CarId" />

    <label>Name:</label>
    <input asp-for="Name" />
    <br />

    <label>Price:</label>
    <input asp-for="Price" />
    <br />

    <button type="submit">Update</button>
</form>
