@model IEnumerable<ToyotaWeb.Models.Car>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>

    body{
        background:#0f172a;
    }

    .page-title{

        color:white;

        font-size:52px;
        font-weight:900;

        margin-bottom:35px;
    }

    .top-bar{

        display:flex;
        justify-content:space-between;
        align-items:center;

        margin-bottom:35px;
    }

    .btn-create{

        background:
            linear-gradient(
                to right,
                #22c55e,
                #16a34a
            );

        color:white;

        padding:14px 24px;

        border-radius:14px;

        text-decoration:none;

        font-weight:700;
    }

    .car-grid{

        display:grid;

        grid-template-columns:
            repeat(auto-fill,minmax(320px,1fr));

        gap:25px;
    }

    .car-card{

        background:
            linear-gradient(
                145deg,
                #111827,
                #1e293b
            );

        border-radius:24px;

        overflow:hidden;

        color:white;

        box-shadow:
            0 10px 30px rgba(0,0,0,0.4);
    }

    .car-image{

        width:100%;
        height:220px;

        object-fit:cover;
    }

    .car-body{

        padding:24px;
    }

    .car-name{

        font-size:28px;
        font-weight:800;

        margin-bottom:12px;
    }

    .car-price{

        color:#38bdf8;

        font-size:22px;
        font-weight:700;

        margin-bottom:10px;
    }

    .car-info{

        color:#cbd5e1;

        margin-bottom:8px;
    }

    .status{

        display:inline-block;

        padding:8px 14px;

        border-radius:30px;

        font-size:14px;
        font-weight:700;

        margin-top:10px;
    }

    .active{

        background:#14532d;
        color:#4ade80;
    }

    .inactive{

        background:#7f1d1d;
        color:#f87171;
    }

    .action-buttons{

        margin-top:20px;

        display:flex;
        gap:10px;
    }

    .btn-edit{

        flex:1;

        background:#f59e0b;

        color:white;

        text-align:center;

        padding:10px;

        border-radius:12px;

        text-decoration:none;

        font-weight:700;
    }

    .btn-delete{

        flex:1;

        background:#dc2626;

        color:white;

        text-align:center;

        padding:10px;

        border-radius:12px;

        text-decoration:none;

        font-weight:700;
    }

</style>

<div class="top-bar">

    <h1 class="page-title">
        🚗 QUẢN LÝ XE
    </h1>

    <a asp-action="Create"
       class="btn-create">

        + Thêm xe mới

    </a>

</div>

<div class="car-grid">

    @foreach (var item in Model)
    {
        <div class="car-card">

            @if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                <img src="@item.ImageUrl"
                     class="car-image" />
            }
            else
            {

                <img src="/images/no-image.png" class="car-image" />
            }

            <div class="car-body">

                <div class="car-name">
                    @item.Name
                </div>

                <div class="car-price">
                    @item.Price.ToString("N0") đ
                </div>

                <div class="car-info">
                    🚘 @item.BodyType
                </div>

                <div class="car-info">
                    👥 @item.Seats chỗ
                </div>

                <div class="car-info">
                    ⛽ @item.FuelType
                </div>

                <div class="car-info">
                    🌍 @item.Origin
                </div>

                @if (item.IsActive)
                {
                    <div class="status active">
                        Đang kinh doanh
                    </div>
                }
                else
                {
                    <div class="status inactive">
                        Ngừng bán
                    </div>
                }

                <div class="action-buttons">

                    <a asp-action="Edit" asp-route-id="@item.CarId" class="btn-edit">

                        Edit

                    </a>

                    <a asp-action="Delete" asp-route-id="@item.CarId" class="btn-delete">

                        Delete

                    </a>

                </div>

            </div>

        </div>
    }

</div>