@model ToyotaWeb.Models.Contact

<h2>Gán Sale cho khách</h2>

<form asp-action="AssignSale" method="post">

@Html.AntiForgeryToken()

<input type="hidden" name="id" value="@Model.Id" />

<div class="form-group">
<label>Tên khách</label>
<input class="form-control" value="@Model.FullName" readonly />
</div>

<div class="form-group">
<label>Chọn Sale</label>

<select name="saleId" asp-items="ViewBag.Sales" class="form-control">
<option value="">-- Chọn Sale --</option>
</select>

</div>

<br>

<button type="submit" class="btn btn-success">
Lưu
</button>

<a asp-action="Index" class="btn btn-secondary">
Quay lại
</a>

</form>