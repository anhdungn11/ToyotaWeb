@{
  Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
  body {
    background: #0f172a;
    color: white;
  }

  .dashboard-title {
    font-size: 38px;
    font-weight: 700;
    margin-bottom: 35px;
  }

  .kpi-card {
    background: linear-gradient(145deg, #111827, #1e293b);
    border-radius: 18px;
    padding: 30px;
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
    transition: 0.3s;
    height: 100%;
  }

  .kpi-card:hover {
    transform: translateY(-5px);
  }

  .kpi-title {
    color: #94a3b8;
    font-size: 15px;
    margin-bottom: 10px;
  }

  .kpi-value {
    font-size: 34px;
    font-weight: bold;
  }

  .section-card {
    background: #111827;
    border-radius: 18px;
    padding: 25px;
    margin-top: 25px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.35);
  }

  .section-title {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .table {
    color: white;
  }

  .table thead {
    color: #94a3b8;
  }

  .badge-custom {
    background: #22c55e;
    color: white;
    padding: 8px 14px;
    border-radius: 20px;
  }

  .insight-box {
    background: linear-gradient(145deg, #1d4ed8, #2563eb);
    padding: 25px;
    border-radius: 18px;
    margin-top: 25px;
    line-height: 1.8;
  }

  .market-warning {
    background: #7f1d1d;
    padding: 20px;
    border-radius: 15px;
  }

  .market-success {
    background: #14532d;
    padding: 20px;
    border-radius: 15px;
  }

  .finance-highlight {
    color: #22c55e;
  }

  .debt-highlight {
    color: #ef4444;
  }

  .enterprise-card {
    background: linear-gradient(145deg, #18253a, #101827);
    border-radius: 20px;
    padding: 25px;
    cursor: pointer;
    transition: 0.35s;
    border: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
    min-height: 220px;
  }

  .enterprise-card:hover {
    transform: translateY(-8px) scale(1.02);

    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(0, 255, 255, 0.25);
  }

  .enterprise-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200px;
    height: 200px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 50%;
  }

  .card-icon {
    font-size: 40px;
    margin-bottom: 20px;
  }

  .card-title {
    color: #9aa4b2;
    font-size: 14px;
    letter-spacing: 1px;
    margin-bottom: 15px;
    font-weight: 600;
  }

  .card-value {
    font-size: 42px;
    font-weight: 800;
    color: white;
    margin-bottom: 20px;
  }

  .card-footer-text {
    color: #7f8ea3;
    font-size: 13px;
  }

  .revenue-card:hover {
    border-color: #00ff99;
  }

  .debt-card:hover {
    border-color: #ff4d4d;
  }

  .order-card:hover {
    border-color: #00ccff;
  }

  .customer-card:hover {
    border-color: #ffd633;
  }

  .tax-card:hover {
    border-color: #ff9900;
  }

  .profit-card:hover {
    border-color: #00ffcc;
  }
</style>

<div class="container-fluid mt-4">
  <div class="dashboard-title">
    🚀 Toyota Enterprise Analytics
  </div>

  <!-- KPI -->
  <div class="row g-4 mb-4">

    <!-- DOANH THU -->
    <div class="col-md-3">

      <div class="enterprise-card revenue-card" onclick="location.href='/Admin/SaleOrder'">

        <div class="card-icon">
          💰
        </div>

        <div class="card-title">
          TỔNG DOANH THU
        </div>

        <div class="card-value text-success">
          @ViewBag.Revenue.ToString("N0") đ
        </div>

        <div class="card-footer-text">
          Phân tích tài chính doanh nghiệp
        </div>

      </div>

    </div>

    <!-- THUẾ -->
    <div class="col-md-3">

      <div class="enterprise-card tax-card">

        <div class="card-icon">
          🏛️
        </div>

        <div class="card-title">
          THUẾ DOANH NGHIỆP
        </div>

        <div class="card-value text-warning">
          @ViewBag.Tax.ToString("N0") đ
        </div>

        <div class="card-footer-text">
          Thuế suất @ViewBag.TaxRate %
        </div>

      </div>

    </div>

    <!-- HOA HỒNG -->
    <div class="col-md-3">

      <div class="enterprise-card customer-card">

        <div class="card-icon">
          👨‍💼
        </div>

        <div class="card-title">
          HOA HỒNG SALE
        </div>

        <div class="card-value text-info">
          @ViewBag.Commission.ToString("N0") đ
        </div>

        <div class="card-footer-text">
          Tổng thưởng nhân viên sale
        </div>

      </div>

    </div>

    <!-- CÔNG NỢ -->
    <div class="col-md-3">

      <div class="enterprise-card debt-card">

        <div class="card-icon">
          📉
        </div>

        <div class="card-title">
          CÔNG NỢ
        </div>

        <div class="card-value text-danger">
          @ViewBag.Debt.ToString("N0") đ
        </div>

        <div class="card-footer-text">
          Theo dõi khách hàng còn nợ
        </div>

      </div>

    </div>

  </div>

  <!-- ROW 2 -->
  <div class="row g-4 mb-4">

    <!-- LỢI NHUẬN -->
    <div class="col-md-6">

      <div class="enterprise-card profit-card">

        <div class="card-icon">
          📈
        </div>

        <div class="card-title">
          LỢI NHUẬN RÒNG
        </div>
        <div class="card-value finance-highlight">
          @ViewBag.Profit.ToString("N0") đ
        </div>

        <div class="card-footer-text">
          Sau thuế, hoa hồng và chi phí vận hành
        </div>

      </div>

    </div>

    <!-- SHOWROOM COST -->
    <div class="col-md-3">

      <div class="enterprise-card">

        <div class="card-icon">
          🏢
        </div>

        <div class="card-title">
          CHI PHÍ SHOWROOM
        </div>

        <div class="card-value text-warning">
          @ViewBag.ShowroomCost.ToString("N0") đ
        </div>

        <div class="card-footer-text">
          Chi phí vận hành hệ thống
        </div>

      </div>

    </div>

    <!-- ĐƠN HÀNG -->
    <div class="col-md-3">

      <div class="enterprise-card order-card" onclick="location.href='/Admin/SaleOrder'">

        <div class="card-icon">
          📦
        </div>

        <div class="card-title">
          ĐƠN HÀNG
        </div>

        <div class="card-value">
          @ViewBag.TotalOrders
        </div>

        <div class="card-footer-text">
          Tổng giao dịch doanh nghiệp
        </div>

      </div>

    </div>

  </div>

  <!-- MARKET -->

<div class="row">

    <div class="col-md-8">

        <div class="section-card">

            <div class="section-title">
                📈 PHÂN TÍCH XE HOT THỊ TRƯỜNG
            </div>

            <table class="table">

                <thead>
                    <tr>
                        <th>Xe</th>
                        <th>Đơn hàng</th>
                        <th>Doanh thu</th>
                        <th>Xu hướng</th>
                    </tr>
                </thead>

                <tbody>

                    @if(ViewBag.TopVehicles != null)
                    {
                        foreach(var item in ViewBag.TopVehicles)
                        {
                            <tr>

                                <td>@item.Car</td>

                                <td>@item.Orders</td>

                                <td class="finance-highlight">
                                    @String.Format("{0:N0}", item.Revenue)
                                </td>

                                <td>
                                    <span class="badge-custom">
                                        Tăng trưởng
                                    </span>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="col-md-4">

        <div class="market-success">

            <h5>
                📊 Insight thị trường
            </h5>

            <p class="mt-3">
                SUV và dòng xe gia đình đang dẫn đầu nhu cầu thị trường.
            </p>

            <p>
                Khách hàng ưu tiên:
            </p>

            <ul>
                <li>Khoang rộng</li>
                <li>Tiết kiệm nhiên liệu</li>
                <li>Trả góp linh hoạt</li>
            </ul>

        </div>

        <div class="market-warning mt-4">

            <h5>
                ⚠ Xe cần cải thiện
            </h5>

            <ul class="mt-3">

                @if(ViewBag.LowCars != null)
                {
                    foreach (var item in ViewBag.LowCars)
                    {
                        <li>@item.Name</li>
                    }
                }

            </ul>

        </div>

    </div>

</div>

<!-- SHOWROOM -->

<div class="section-card">

    <div class="section-title">
        🏢 HIỆU SUẤT SHOWROOM
    </div>

    <table class="table">

        <thead>

            <tr>
                <th>Showroom</th>
                <th>Đơn hàng</th>
                <th>Doanh thu</th>
                <th>Đánh giá</th>
            </tr>

        </thead>

        <tbody>

            @if(ViewBag.Showrooms != null)
            {
                foreach (var item in ViewBag.Showrooms)
                {
                    <tr><td>@item.Showroom</td>

                        <td>@item.Orders</td>

                        <td class="finance-highlight">
                            @String.Format("{0:N0}", item.Revenue)
                        </td>

                        <td>

                            @if(item.Revenue > 1000000000)
                            {
                                <span class="badge bg-success">
                                    Hiệu suất cao
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Cần cải thiện
                                </span>
                            }

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>

<!-- GOLDEN HOUR -->

<div class="section-card">

    <div class="section-title">
        ⏰ GIỜ VÀNG ĐĂNG KÝ LÁI THỬ
    </div>

    <div class="row">

        @if(ViewBag.GoldenHours != null)
        {
            foreach (var item in ViewBag.GoldenHours)
            {
                <div class="col-md-3 mb-3">

                    <div class="kpi-card text-center">

                        <h5>@item.Time</h5>

                        <h2>@item.Count</h2>

                        <p>Lượt đăng ký</p>

                    </div>

                </div>
            }
        }

    </div>

</div>

<!-- AI BUSINESS -->

<div class="insight-box">

    <h3>
        🧠 AI BUSINESS STRATEGY
    </h3>

    <p class="mt-4">
        @ViewBag.BusinessInsight
    </p>

    <p>
        Đề xuất:
    </p>

    <ul>
        <li>Tăng quảng cáo Facebook cho dòng SUV</li>
        <li>Đẩy mạnh trả góp showroom Bình Dương</li>
        <li>Tập trung chiến dịch khách hàng gia đình</li>
        <li>Tối ưu sale conversion vào khung giờ vàng</li>
    </ul>

</div>