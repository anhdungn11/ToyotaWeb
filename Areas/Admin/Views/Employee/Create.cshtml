@model ToyotaWeb.Models.EmployeeProfile

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>

    .create-wrapper{
        max-width:1000px;
        margin:auto;
    }

    .create-card{

        background:
            linear-gradient(
                135deg,
                #111827,
                #1e293b
            );

        border-radius:24px;

        padding:40px;

        border:1px solid #334155;

        color:white;
    }

    .title{
        font-size:42px;
        font-weight:800;
        margin-bottom:35px;
    }

    .grid{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:25px;
    }

    .form-group{
        margin-bottom:22px;
    }

    label{
        margin-bottom:10px;
        display:block;
        font-weight:700;
    }

    .form-control{

        width:100%;

        padding:14px;

        border-radius:12px;

        border:none;

        background:#0f172a;

        color:white;

        font-size:16px;
    }

    .btn-save{

        margin-top:30px;

        background:#22c55e;

        color:white;

        border:none;

        padding:15px 35px;

        border-radius:14px;

        font-size:18px;

        font-weight:700;
    }

</style>

<div class="create-wrapper">

    <div class="create-card">

        <div class="title">
            👨‍💼 Thêm nhân viên
        </div>

        <form method="post"
              enctype="multipart/form-data">

            <div class="grid">

                <div>

                    <div class="form-group">
                        <label>Họ tên</label>

                        <input asp-for="FullName"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Số điện thoại</label>

                        <input asp-for="Phone"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>

                        <input asp-for="Email"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>CCCD</label>

                        <input asp-for="CitizenId"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Địa chỉ</label>

                        <input asp-for="Address"
                               class="form-control" />
                    </div>

                </div>

                <div>

                    <div class="form-group">
                        <label>Phòng ban</label>

                        <input asp-for="Department"
                               class="form-control" />
                    </div>

                    <div class="form-group"><label>Chức vụ</label>

                        <input asp-for="Position" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Lương cơ bản</label>

                        <input asp-for="BaseSalary" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Ngày vào làm</label>

                        <input asp-for="JoinDate" type="date" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Ảnh nhân viên</label>

                        <input type="file" name="ImageFile" class="form-control" />
                    </div>

                </div>

            </div>

            <button class="btn-save">
                + Thêm nhân viên
            </button>

        </form>

    </div>

</div>