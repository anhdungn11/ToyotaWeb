@model IEnumerable<ToyotaWeb.Models.EmployeeProfile>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>

    body{
        background:#0f172a;
    }

    .page-title{
        color:white;
        font-size:48px;
        font-weight:800;
        margin-bottom:35px;
    }

    .top-bar{
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:30px;
    }

    .btn-create{
        background:#22c55e;
        color:white;
        padding:14px 22px;
        border-radius:14px;
        text-decoration:none;
        font-weight:700;
    }

    .employee-grid{
        display:grid;
        grid-template-columns:
            repeat(auto-fill,minmax(320px,1fr));

        gap:25px;
    }

    .employee-card{
        background:
            linear-gradient(
                135deg,
                #111827,
                #1e293b
            );

        border-radius:24px;

        padding:28px;

        border:1px solid #334155;

        transition:0.3s;
    }

    .employee-card:hover{
        transform:translateY(-6px);
        border-color:#38bdf8;
    }

    .avatar{
        width:90px;
        height:90px;
        border-radius:50%;
        object-fit:cover;
        margin-bottom:20px;
        border:3px solid #38bdf8;
    }

    .name{
        color:white;
        font-size:28px;
        font-weight:800;
        margin-bottom:10px;
    }

    .code{
        color:#38bdf8;
        font-weight:700;
        margin-bottom:18px;
    }

    .info{
        color:#cbd5e1;
        margin-bottom:10px;
        font-size:15px;
    }

    .badge-status{
        display:inline-block;
        padding:8px 14px;
        border-radius:30px;
        background:#052e16;
        color:#22c55e;
        font-weight:700;
        margin-top:15px;
    }

    .btn-detail{
        display:block;
        margin-top:25px;
        text-align:center;
        background:#2563eb;
        color:white;
        text-decoration:none;
        padding:12px;
        border-radius:12px;
        font-weight:700;
    }

</style>

<div class="top-bar">

    <h1 class="page-title">
        👨‍💼 HR MANAGEMENT
    </h1>

    <a href="/Admin/Employee/Create"
       class="btn-create">

        + Thêm nhân viên

    </a>

</div>

<div class="employee-grid">

    @foreach(var item in Model)
    {
        <div class="employee-card">

            <img class="avatar"
                 src="@(item.Avatar ?? "https://via.placeholder.com/150")" />

            <div class="name">
                @item.FullName
            </div>

            <div class="code">
                @item.EmployeeCode
            </div>

            <div class="info">
                🏢 Phòng ban:
                @item.Department
            </div>

            <div class="info">
                💼 Chức vụ:
                @item.Position
            </div>

            <div class="info">
                💰 Lương:@item.BaseSalary.ToString("N0") đ
            </div>

            <div class="info">
                📅 Ngày vào làm:
                @(item.JoinDate?.ToString("dd/MM/yyyy"))
            </div>

            <div class="info">
                📞 SĐT:
                @item.Phone
            </div>

            <div class="badge-status">
                @(item.Status ?? "Đang làm việc")
            </div>

            <a href="/Admin/Employee/Details/@item.Id" class="btn-detail">

                Xem hồ sơ

            </a>
            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning mt-2">

                ✏️ Sửa

            </a>
        </div>
    }

</div>