@model ToyotaWeb.Models.SaleKPI

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body {
        background: #0f172a;
    }

    .form-card {

        max-width: 900px;
        margin: auto;

        background:
            linear-gradient(145deg,
                #111827,
                #1e293b);

        padding: 40px;

        border-radius: 24px;

        border: 1px solid rgba(255, 255, 255, 0.08);

        color: white;
    }

    .title {

        font-size: 48px;
        font-weight: 900;

        margin-bottom: 35px;
    }

    .form-label {

        margin-bottom: 10px;
        font-weight: 700;
    }

    .form-control,
    .form-select {

        background: #0f172a;
        border: 1px solid #334155;

        color: white;

        padding: 14px;

        border-radius: 14px;

        margin-bottom: 20px;
    }

    .btn-save {

        background:
            linear-gradient(to right,
                #22c55e,
                #16a34a);

        border: none;

        padding: 14px 28px;

        border-radius: 14px;

        color: white;

        font-weight: 700;
    }
</style>

<div class="form-card">

    <div class="title">
        🎯 Tạo KPI nhân viên
    </div>

    <form method="post">

        <label class="form-label">
            Nhân viên
        </label>

        <select asp-for="EmployeeId" class="form-select">

            @foreach (var item in ViewBag.Employees)
            {
                <option value="@item.Id">

                    @item.FullName

                </option>
            }

        </select>

        <label class="form-label">
            KPI doanh thu
        </label>

        <input asp-for="TargetRevenue" class="form-control" />

        <label class="form-label">
            Doanh thu hiện tại
        </label>

        <input asp-for="CurrentRevenue" class="form-control" />

        <label class="form-label">
            KPI đơn hàng
        </label>

        <input asp-for="TargetOrders" class="form-control" />

        <label class="form-label">
            Đơn hàng hiện tại
        </label>

        <input asp-for="CurrentOrders" class="form-control" />

        <label class="form-label">
            Tháng
        </label>

        <input asp-for="Month" class="form-control" />

        <label class="form-label">
            Năm
        </label>

        <input asp-for="Year" class="form-control" />

        <button class="btn-save">
            💾 Lưu KPI
        </button>

    </form>

</div>