@model List<ToyotaWeb.Models.SOSRequest>

<h2>🚨 Danh sách SOS</h2>

<table class="table">
    <thead>
        <tr>
            <th>Tên</th>
            <th>SĐT</th>
            <th>Mô tả</th>
            <th>Ảnh</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Description</td>

                <td>
                    <a href="@item.ImagePath" target="_blank">
                        <img src="@item.ImagePath" width="100" style="cursor:pointer;" />
                    </a>
                </td>

                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>