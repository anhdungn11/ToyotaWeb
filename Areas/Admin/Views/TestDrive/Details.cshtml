@model ToyotaWeb.Models.Customer

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>👤 Hồ sơ khách hàng</h2>

<div class="card p-3 mb-3">
    <h4>@Model.FullName</h4>
    <p>📞 @Model.Phone</p>
    <p>📧 @Model.Email</p>
    <p>📍 @Model.Address</p>
    <p>💰 Ngân sách: @Model.Budget</p>
    <p>📌 Trạng thái: @Model.Status</p>
</div>

<hr />

<h4>🚗 Xe đã mua</h4>

<table class="table">
    <tr>
        <th>Xe</th>
        <th>Giá</th>
        <th>Ngày mua</th>
    </tr>

    @foreach (var car in ViewBag.Cars)
    {
        <tr>
            <td>@car.CarName</td>
            <td>@car.Price</td>
            <td>@car.PurchaseDate.ToString("dd/MM/yyyy")</td>
        </tr>
    }
</table>

<hr />

<h4>📞 Lịch sử tư vấn</h4>

<ul class="list-group">
    @foreach (var item in ViewBag.Interactions)
    {
        <li class="list-group-item">
            <b>@item.CreatedAt:</b> @item.Content
        </li>
    }
</ul>