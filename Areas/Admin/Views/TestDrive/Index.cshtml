@model IEnumerable<ToyotaWeb.Models.TestDrive>

@{
    ViewData["Title"] = "Quản lý đăng ký lái thử";
}

<div class="container mt-4">

    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0"> Danh sách khách đăng ký lái thử</h4>
        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped">
                <thead class="table-primary">
                    <tr class="text-center">
                        <th>Họ tên</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Mẫu xe</th>
                        <th>Ngày đăng ký</th>
                        <th>Trạng thái</th>
                        <th width="160">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td>@item.CarName</td>
                            <td>@item.RegisterDate?.ToString("dd/MM/yyyy")</td>

                            @* <td class="text-center">
                                @if (item.IsProcessed)
                                {
                                    <span class="badge bg-success">Đã liên hệ</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chưa xử lý</span>
                                }
                            </td> *@

                            <td class="text-center">

                                @if (!item.IsProcessed)
                                {
                                    <a asp-action="Approve"           asp-route-id="@item.Id" class="btn btn-sm btn-success me-1">
                                        <i class="fa fa-check"></i> Duyệt
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-success me-1">
                                        <i class="fa fa-check-circle"></i> Đã duyệt
                                    </span>
                                }

                                <a asp-action="Delete"     asp-route-id="@item.Id"     class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash"></i> Xoá
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>