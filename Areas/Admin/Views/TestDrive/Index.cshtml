@model IEnumerable<ToyotaWeb.Models.TestDrive>

@{
    ViewData["Title"] = "Quản lý đăng ký lái thử";
}

<div class="container mt-4">

    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">🚗 Danh sách khách đăng ký lái thử</h4>
        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped align-middle">
                <thead class="table-primary text-center">
                    <tr>
                        <th>Họ tên</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Mẫu xe</th>
                        <th>Mã</th>
                        <th>Check-in</th>
                        <th>CCCD</th>
                        <th>Bằng lái</th>
                        <th>Ngày đăng ký</th>
                        <th>Trạng thái</th>
                        <th width="260">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td>@item.CarName</td>

                            <!-- 🔑 MÃ -->
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ConfirmCode))
                                {
                                    <span class="badge bg-danger copy-code"
                                          onclick="copyCode('@item.ConfirmCode')">
                                        @item.ConfirmCode
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có</span>
                                }
                            </td>

                            <!-- ✅ CHECK-IN -->
                            <td class="text-center">
                                @if (item.IsCheckedIn)
                                {
                                    <span class="badge bg-success">✔ Đã đến</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa đến</span>
                                }
                            </td>

                            <!-- CCCD -->
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.CCCDImage))
                                {
                                    <img src="@item.CCCDImage"
                                         class="img-thumb"onclick="openModal('@item.CCCDImage')" />
                                }
                            </td>

                            <!-- BẰNG LÁI -->
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.LicenseImage))
                                {
                                    <img src="@item.LicenseImage"
                                         class="img-thumb"
                                         onclick="openModal('@item.LicenseImage')" />
                                }
                            </td>

                            <td class="text-center">
                                @item.RegisterDate?.ToString("dd/MM/yyyy")
                            </td>

                            <!-- 🔥 STATUS CHUẨN -->
                            <td class="text-center">
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Đã duyệt</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Từ chối</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                }
                            </td>

                            <!-- ACTION -->
                            <td class="text-center">

                                @if (!item.IsProcessed)
                                {
                                    <!-- ✔ APPROVE -->
                                    <form asp-action="Approve" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-success btn-sm me-1">
                                            ✔ Duyệt
                                        </button>
                                    </form>

                                    <!-- ❌ REJECT -->
                                    <form asp-action="Reject" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-warning btn-sm me-1">
                                            ✖ Từ chối
                                        </button>
                                    </form>
                                }

                                <!-- 🗑 DELETE --><a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-danger">
                                    🗑 Xóa
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>

</div>

<!-- ================= MODAL ================= -->
<div id="imageModal" class="modal-custom">
    <span class="close-btn" onclick="closeModal()">&times;</span>
    <img class="modal-content" id="modalImage">
</div>

<!-- ================= STYLE ================= -->
<style>

.img-thumb {
    width: 65px;
    height: 65px;
    object-fit: cover;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.3s;
}

.img-thumb:hover {
    transform: scale(1.1);
}

/* MODAL */
.modal-custom {
    display: none;
    position: fixed;
    z-index: 9999;
    padding-top: 80px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.9);
}

.modal-content {
    margin: auto;
    display: block;
    max-width: 80%;
    max-height: 80%;
    border-radius: 10px;
}

.close-btn {
    position: absolute;
    top: 20px;
    right: 40px;
    color: white;
    font-size: 40px;
    cursor: pointer;
}

/* COPY */
.copy-code {
    cursor: pointer;
    transition: 0.2s;
}

.copy-code:hover {
    background: black;
}

</style>

<!-- ================= SCRIPT ================= -->
<script>

function openModal(src) {
    document.getElementById("imageModal").style.display = "block";
    document.getElementById("modalImage").src = src;
}

function closeModal() {
    document.getElementById("imageModal").style.display = "none";
}

window.onclick = function(event) {
    var modal = document.getElementById("imageModal");
    if (event.target == modal) {
        modal.style.display = "none";
    }
}

// COPY CODE
function copyCode(code) {
    navigator.clipboard.writeText(code);
    alert("Đã copy mã: " + code);
}

</script>