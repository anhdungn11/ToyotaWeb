@model List<ToyotaWeb.Models.Contact>

@{
    Layout = "~/Areas/Sale/Views/Shared/_SaleLayout.cshtml";

    int total = Model.Count;
    int called = Model.Count(x => x.IsCalled);
    int pending = total - called;
}

<style>

    .stats{
        display:grid;
        grid-template-columns:repeat(3,1fr);
        gap:20px;
        margin-bottom:30px;
    }

    .card-box{
        background:#111827;
        border-radius:20px;
        padding:25px;
        color:white;
    }

    .number{
        font-size:40px;
        font-weight:900;
    }

    .table-box{
        background:white;
        border-radius:20px;
        overflow:hidden;
    }

    .badge-ok{
        background:#16a34a;
        color:white;
        padding:6px 12px;
        border-radius:20px;
    }

    .badge-no{
        background:#dc2626;
        color:white;
        padding:6px 12px;
        border-radius:20px;
    }

</style>

<h1 class="text-white mb-4">
    📞 KHÁCH TƯ VẤN
</h1>

<div class="stats">

    <div class="card-box">

        <div>Tổng khách</div>

        <div class="number">
            @total
        </div>

    </div>

    <div class="card-box">

        <div>Đã gọi</div>

        <div class="number">
            @called
        </div>

    </div>

    <div class="card-box">

        <div>Chưa gọi</div>

        <div class="number">
            @pending
        </div>

    </div>

</div>

<div class="table-box">

<table class="table table-bordered mb-0">

    <thead class="table-dark">

        <tr>

            <th>Khách</th>
            <th>SĐT</th>
            <th>Email</th>
            <th>Xe</th>
            <th>Ngày</th>
            <th>Trạng thái</th>
            <th width="300">Thao tác</th>

        </tr>

    </thead>

    <tbody>

@foreach(var item in Model)
{
    <tr>

        <td>
            <b>@item.FullName</b>
        </td>

        <td>
            @item.Phone
        </td>

        <td>
            @item.Email
        </td>

        <td>
            @item.CarName
        </td>

        <td>
            @item.CreatedAt.ToString("dd/MM/yyyy")
        </td>

        <td>

            @if(item.IsCalled)
            {
                <span class="badge-ok">
                    Đã gọi
                </span>
            }
            else
            {
                <span class="badge-no">
                    Chưa gọi
                </span>
            }

        </td>

        <td>

            @if(!item.IsCalled)
            {
                <button onclick="showBox(@item.Id)"
                        class="btn btn-success btn-sm">

                    Đã gọi

                </button>
            }

        </td>

    </tr>

    <tr id="box-@item.Id"
        style="display:none;">

        <td colspan="7">

            <textarea id="note-@item.Id"
                      class="form-control"
                      placeholder="Nhập ghi chú..."></textarea>

                        <br /><button onclick="saveCall(@item.Id)" class="btn btn-primary btn-sm">

                        Lưu ghi chú

                    </button>

                </td>

            </tr>
        }

    </tbody>

</table>

</div>

<script>

    function showBox(id) {
        document.getElementById(
            "box-" + id
        ).style.display = "table-row";
    }

    function saveCall(id) {
        let note = document.getElementById(
            "note-" + id
        ).value;

        fetch('/Sale/Contacts/MarkAsCalled', {

            method: 'POST',

            headers: {
                'Content-Type':
                    'application/x-www-form-urlencoded'
            },

            body:
                'id=' + id +
                '&note=' + encodeURIComponent(note)

        })

            .then(r => r.json())

            .then(data => {

                if (data.success) {
                    alert("Đã lưu");

                    location.reload();
                }

            });
    }

</script>