@model ToyotaWeb.Models.Customer

@{
    Layout = "~/Areas/Sale/Views/Shared/_SaleLayout.cshtml";
}

<style>
    .page-title {
        color: white;
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 35px;
    }

    .crm-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .crm-card {
        background:
            linear-gradient(135deg,
                #111827,
                #1e293b);

        border-radius: 24px;

        padding: 30px;

        border: 1px solid #334155;

        box-shadow:
            0 0 40px rgba(0, 0, 0, 0.35);
    }

    .crm-title {
        color: white;
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 25px;
    }

    .info-row {
        margin-bottom: 18px;
        color: #e2e8f0;
        font-size: 16px;
    }

    .label {
        color: #94a3b8;
        font-weight: 700;
    }

    .timeline-item {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 18px;
    }

    .timeline-type {
        color: #38bdf8;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .timeline-date {
        color: #94a3b8;
        font-size: 13px;
        margin-top: 10px;
    }

    .form-control,
    .form-select {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        border-radius: 12px;
        padding: 14px;
    }

    .form-control:focus,
    .form-select:focus {
        background: #0f172a;
        color: white;
        border-color: #38bdf8;
        box-shadow: none;
    }

    .btn-save {
        background: #22c55e;
        border: none;
        color: white;
        padding: 14px 22px;
        border-radius: 14px;
        font-weight: 800;
    }

    .btn-save:hover {
        background: #16a34a;
    }

    .status-badge {
        background: #052e16;
        color: #22c55e;
        padding: 8px 14px;
        border-radius: 30px;
        font-weight: 800;
        display: inline-block;
    }
</style>

<h1 class="page-title">
    👤 CUSTOMER CRM DETAILS
</h1>

<div class="crm-grid">

    <!-- CUSTOMER INFO -->

    <div class="crm-card">

        <div class="crm-title">
            📋 Thông tin khách hàng
        </div>

        <div class="info-row">
            <span class="label">Họ tên:</span>
            @Model.FullName
        </div>

        <div class="info-row">
            <span class="label">Điện thoại:</span>
            @Model.Phone
        </div>

        <div class="info-row">
            <span class="label">Email:</span>
            @Model.Email
        </div>

        <div class="info-row">
            <span class="label">Ngân sách:</span>
            @(Model.Budget?.ToString("N0") ?? "0") đ
        </div>

        <div class="info-row">

            <span class="label">Trạng thái:</span>

            <span class="status-badge">
                @Model.Status
            </span>

        </div>
        <div class="info-row">

            <span class="label">Sale phụ trách:</span>

            @(Model.Sale?.Name ?? "Chưa có")

        </div>
        <a href="/Sale/SaleOrder/Create?customerId=@Model.Id" class="btn btn-primary mt-4">

            🚗 Tạo hợp đồng mua xe

        </a>
        <!-- UPDATE STATUS -->

        <form method="post" action="/Sale/Customer/UpdateStatus">

            @Html.AntiForgeryToken()

            <input type="hidden" name="customerId" value="@Model.Id" />

            <div class="mt-4">

                <select name="status" class="form-select">

                    <option value="Mới">
                        Mới
                    </option>

                    <option value="Đang tư vấn">
                        Đang tư vấn
                    </option>

                    <option value="Đã lái thử">
                        Đã lái thử
                    </option>

                    <option value="Đàm phán">
                        Đàm phán
                    </option>

                    <option value="Đã cọc">
                        Đã cọc
                    </option>

                    <option value="Đã mua">
                        Đã mua
                    </option>

                </select>

            </div>

            <button type="submit" class="btn-save mt-3">

                Cập nhật trạng thái

            </button>

        </form>

    </div>

    <!-- ADD INTERACTION -->

    <div class="crm-card">

        <div class="crm-title">
            📝 Thêm chăm sóc khách hàng
        </div>

        <form method="post" action="/Sale/Customer/AddInteraction">

            @Html.AntiForgeryToken()

            <input type="hidden" name="customerId" value="@Model.Id" />

            <div class="mb-3">

                <label class="text-white mb-2">
                    Loại chăm sóc
                </label>

                <select name="type" class="form-select">

                    <option value="Gọi điện">
                        Gọi điện
                    </option>

                    <option value="Tư vấn showroom">
                        Tư vấn showroom
                    </option>

                    <option value="Hẹn gặp">
                        Hẹn gặp
                    </option>

                    <option value="Follow-up">
                        Follow-up
                    </option>

                    <option value="Đàm phán">
                        Đàm phán
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label class="text-white mb-2">
                    Nội dung
                </label>

                <textarea name="content" class="form-control" rows="5" required></textarea>

            </div>

            <div class="mb-3">

                <label class="text-white mb-2">
                    Ngày follow-up tiếp theo
                </label>

                <input type="date" name="nextFollowUpDate" class="form-control" />

            </div>

            <button type="submit" class="btn-save">

                Lưu CRM

            </button>

        </form>

    </div>

</div>

<!-- TIMELINE -->

<div class="crm-card mt-4">

    <div class="crm-title">
        📈 CRM Timeline
    </div>

    @if (ViewBag.Interactions != null)
    {
        foreach (var item in ViewBag.Interactions)
        {
            <div class="timeline-item">

                <div class="timeline-type">
                    @item.Type
                </div>

                <div style="color:white">
                    @item.Content
                </div>

                @if (item.NextFollowUpDate != null)
                {
                    <div class="mt-3" style="
                        color:#f59e0b;
                        font-weight:700
                        ">

                        📅 Follow-up:
                        @(Convert.ToDateTime(item.NextFollowUpDate)
                        .ToString("dd/MM/yyyy"))

                    </div>
                }

                <div class="timeline-date">

                    @(Convert.ToDateTime(item.CreatedAt)
                    .ToString("dd/MM/yyyy HH:mm"))

                </div>

            </div>
        }
    }
    else
    {
        <div style="color:#94a3b8">

            Chưa có lịch sử chăm sóc khách hàng

        </div>
    }

</div>