<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <title>Sale CRM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>

        body{
            margin:0;
            background:#0f172a;
            font-family:'Segoe UI';
            overflow-x:hidden;
        }

        .sidebar{
            width:280px;
            min-height:100vh;

            background:
                linear-gradient(
                    180deg,
                    #020617,
                    #111827
                );

            padding:30px 20px;

            border-right:1px solid #1e293b;

            position:fixed;
        }

        .logo{
            color:white;
            font-size:34px;
            font-weight:800;
            margin-bottom:40px;
        }

        .menu-title{
            color:#64748b;
            font-size:13px;
            font-weight:800;
            margin-top:30px;
            margin-bottom:12px;
            letter-spacing:1px;
        }

        .sidebar a{
            display:flex;
            align-items:center;
            gap:12px;
            color:#e2e8f0;
            text-decoration:none;
            padding:14px 16px;
            border-radius:14px;
            margin-bottom:10px;
            transition:0.25s;
            font-weight:600;
        }

        .sidebar a:hover{
            background:#1e293b;
            color:#38bdf8;
            transform:translateX(5px);
        }

        .main{
            margin-left:280px;
            min-height:100vh;
        }

        .header{
            height:75px;
            background:#111827;

            border-bottom:1px solid #1e293b;

            display:flex;
            justify-content:space-between;
            align-items:center;

            padding:0 30px;

            color:white;

            position:sticky;
            top:0;
            z-index:999;
        }

        .body-content{
            padding:35px;
        }

    </style>

</head>

<body>

<div class="sidebar">

    <div class="logo">
        🚗 Sale CRM
    </div>

    <div class="menu-title">
        SALES MANAGEMENT
    </div>

    <a href="/Sale/Dashboard">

        <i class="fa-solid fa-chart-line"></i>

        Dashboard

    </a>

    <a href="/Sale/Customer">

        <i class="fa-solid fa-users"></i>

        Khách hàng

    </a>

    <a href="/Sale/SaleOrder">

        <i class="fa-solid fa-file-invoice"></i>

        Đơn hàng

    </a>

    <a href="/Sale/TestDrive">

        <i class="fa-solid fa-road"></i>

        Đăng ký lái thử

    </a>

    <!-- FIX -->
    @* <a href="/Sale/Contacts">

        <i class="fa-solid fa-headset"></i>

        Khách tư vấn

    </a> *@

    <div class="menu-title">
        QUICK ACCESS
        </div><a href="/Admin/Dashboard">

        <i class="fa-solid fa-arrow-left"></i>

        Admin Panel

    </a>

    <a href="/">

        <i class="fa-solid fa-house"></i>

        Trang chủ

    </a>

</div>

<div class="main">

    <div class="header">

        <h5 class="mb-0">
            🚀 Toyota Sales CRM
        </h5>

        <div>

            <span class="me-3">
                Xin chào Sale
            </span>

            <a href="/Account/Logout" class="btn btn-danger btn-sm">

                Đăng xuất

            </a>

        </div>

    </div>

    <div class="body-content">

        @RenderBody()

        @RenderSection("Scripts", required: false)

    </div>

</div>

</body>

</html>