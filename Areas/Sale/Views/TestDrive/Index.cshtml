@model IEnumerable<ToyotaWeb.Models.TestDrive>

@{
    Layout = "~/Areas/Sale/Views/Shared/_SaleLayout.cshtml";
}

<style>
    .page-title {
        color: white;
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 35px;
    }

    .crm-box {
        background:
            linear-gradient(135deg,
                #111827,
                #1e293b);

        border-radius: 24px;

        padding: 30px;

        border: 1px solid #334155;

        box-shadow:
            0 0 40px rgba(0, 0, 0, 0.35);
    }

    .table {
        color: white;
    }

    .table th {
        border-color: #334155;
        color: #94a3b8;
        font-size: 15px;
    }

    .table td {
        border-color: #1e293b;
        vertical-align: middle;
        font-weight: 600;
    }

    .status {
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
        display: inline-block;
    }

    .approved {
        background: #052e16;
        color: #22c55e;
    }

    .btn-detail {
        background: #2563eb;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
    }

    .btn-detail:hover {
        background: #1d4ed8;
        color: white;
    }
</style>

<h1 class="page-title">
    🚗 TEST DRIVE CRM
</h1>

<div class="crm-box">

    <table class="table">

        <thead>

            <tr>

                <th>
                    Khách hàng
                </th>

                <th>
                    Xe
                </th>

                <th>
                    Ngày lái thử
                </th>

                <th>
                    Giờ
                </th>

                <th>
                    Showroom
                </th>

                <th>
                    Mã xác nhận
                </th>

                <th>
                    Trạng thái
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.FullName
                    </td>

                    <td>
                        @item.CarName
                    </td>

                    <td>
                        @(item.TestDate.HasValue ? item.TestDate.Value.ToString("dd/MM/yyyy") : "")
                    </td>

                    <td>
                        @item.TimeSlot
                    </td>

                    <td>
                        @item.Showroom
                    </td>

                    <td style="color:#38bdf8;font-weight:800">

                        @item.ConfirmCode

                    </td>

                    <td>

                        <span class="status approved">

                            Approved

                        </span>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>