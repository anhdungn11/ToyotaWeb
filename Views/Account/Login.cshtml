@model ToyotaWeb.Models.LoginViewModel
<link rel="stylesheet" href="/css/auth.css?v=999" />

<div class="auth-container">
    <h2>Đăng nhập</h2>

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <input asp-for="Email" placeholder="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <input asp-for="Password" type="password" placeholder="Mật khẩu" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <button type="submit">Đăng nhập</button>
    </form>

    <p class="switch">
        <a href="/Account/ForgotPassword">Quên mật khẩu?</a>
    </p>

    <p class="switch">
        Chưa có tài khoản? <a href="/Account/Register">Đăng ký</a>
    </p>
</div>