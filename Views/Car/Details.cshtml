@model ToyotaWeb.Models.Car
@using ToyotaWeb.Models
@using System.Globalization

<link rel="stylesheet" href="~/css/details.css" />

@{
    var images = Model.CarImages?.ToList() ?? new List<CarImage>();

    string mainImage = "";

    // Ưu tiên ảnh màu xe
    if (images.Any())
    {
        mainImage = Url.Content("~/images/cars/" + images.First().ImageUrl);
    }
    // Nếu không có thì lấy ảnh upload
    else if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        mainImage = Model.ImageUrl;
    }
    // fallback
    else
    {
        mainImage = Url.Content("~/images/no-image.jpg");
    }
}

<div class="car-detail-container">

    <!-- LEFT -->
    <div class="car-left">

        <img id="mainImg" src="@mainImage" class="main-image" />

        <div class="color-list">

            @* NẾU CÓ HỆ ĐỔI MÀU XE *@
            @if (images.Any())
            {
                @foreach (var img in images)
                {
                    <img src="@Url.Content("~/images/cars/" + img.ImageUrl)" class="color-item" onclick="changeImage(this)" />
                }
            }
            @* NẾU CHỈ UPLOAD 1 ẢNH *@
            else if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="color-item active" onclick="changeImage(this)" />
            }

        </div>

    </div>

    <!-- RIGHT -->
    <div class="car-right">

        <h1>@Model.Name</h1>

        <p class="price">
            Từ @Model.Price.ToString("N0") đ
        </p>

        <!-- ACTION -->
        <div class="car-actions">

            <a asp-controller="DangKyLaiThu" asp-action="Create" asp-route-dongXe="@Model.Name" class="btn-action red">

                Đăng ký lái thử

            </a>

            <a asp-controller="Car" asp-action="Estimate" asp-route-slug="@Model.Slug" class="btn-action black">

                Dự toán

            </a>

            <a asp-controller="Rolling" asp-action="Index" asp-route-slug="@Model.Slug" class="btn-action outline">

                Giá lăn bánh

            </a>
            <a asp-controller="Contacts" asp-action="Consult" asp-route-carName="@Model.Name"
               class="btn-action consult-btn">

                Tư vấn ngay

            </a>

        </div>

        <!-- VIDEO -->
        <div class="car-video">

            <video controls width="100%">

                <source src="/Videos/@(Model.Slug).mp4" type="video/mp4">

            </video>

        </div>

        <div class="car-info">

            <p>
                <b>Loại xe:</b>
                @Model.BodyType
            </p>

            <p>
                <b>Số chỗ:</b>
                @Model.Seats
            </p>

            <p>
                <b>Nhiên liệu:</b>
                @Model.FuelType
            </p>

            <p><b>Xuất xứ:</b>
                @Model.Origin
            </p>

        </div>

        <p class="description">
            @Model.Description
        </p>

    </div>

</div>

    </div>

</div>
<script>

    function changeImage(el) {
        let main = document.getElementById("mainImg");

        main.src = el.src;

        document.querySelectorAll(".color-item")
            .forEach(x => x.classList.remove("active"));

        el.classList.add("active");
    }

    document.addEventListener("DOMContentLoaded", function () {
        let first = document.querySelector(".color-item");

        if (first) {
            first.classList.add("active");
        }
    });

</script>
