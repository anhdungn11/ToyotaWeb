@model List<Car>

<h2>Kết quả tìm kiếm</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        Không tìm thấy xe phù hợp.
    </div>
}
else
{
    <div class="row">

        @foreach (var car in Model)
        {
            string imageUrl = "";

            // Ưu tiên ImageUrl mới
            if (!string.IsNullOrEmpty(car.ImageUrl))
            {
                imageUrl = car.ImageUrl;
            }
            // fallback ảnh cũ từ CarImages
            else if (car.CarImages != null && car.CarImages.Any())
            {
                imageUrl = "/images/cars/" + car.CarImages.FirstOrDefault()?.ImageUrl;
            }
            // không có ảnh
            else
            {
                imageUrl = "/images/no-image.png";
            }

            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow">

                    <img src="@imageUrl" class="card-img-top" alt="@car.Name" style="height:220px; object-fit:cover;" />

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @car.Name
                        </h5>

                        <p class="card-text">
                            @car.BodyType - @car.Seats chỗ
                        </p>

                        <p class="fw-bold text-danger">
                            @car.Price.ToString("N0") đ
                        </p>

                        @if (!string.IsNullOrEmpty(car.Slug))
                        {
                            <a asp-controller="Car" asp-action="Details" asp-route-slug="@car.Slug" class="btn btn-primary mt-auto">

                                Xem chi tiết

                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary mt-auto" disabled>
                                Chưa có chi tiết
                            </button>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}