@model ToyotaWeb.Models.TestDrive

@{
    ViewData["Title"] = "Đăng ký lái thử";
}

<link rel="stylesheet" href="~/css/testdrive.css" />

<div class="container d-flex justify-content-center">
    <div class="form-card">

        <h2 class="text-center mb-4">
             Đăng ký lái thử Toyota
        </h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["Success"]
            </div>
        }

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="row">
                <div class="col-md-6">
                    <label> Họ và tên</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label> SĐT Đăng Ký</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <label> Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <label> Dòng xe lái thử</label>
                <select asp-for="CarName" class="form-control">
                    <option value="">-- Chọn xe --</option>
                    @foreach (var car in ViewBag.CarList)
                    {
                        <option value="@car.Name">@car.Name</option>
                    }
                </select>
            </div>

            <div class="mt-3">
                <label> Khu vực</label>
                <input asp-for="Location" id="locationBox" class="form-control" placeholder="Đang lấy vị trí..." />
            </div>

            <div class="mt-3">
                <label>Showroom gần bạn</label>
                <select asp-for="Showroom" id="showroomSelect" class="form-control"></select>
            </div>

            <div id="suggestBox" class="suggest-box"></div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <label> Ngày Đăng Ký Lái Thử</label>
                    <input asp-for="TestDate" type="date" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Khung Giờ Đăng Ký Lái Thử</label>
                    <select asp-for="TimeSlot" class="form-control">
                        <option value="">-- Chọn --</option>
                        <option>08:00 - 09:00</option>
                        <option>09:00 - 10:00</option>
                        <option>10:00 - 11:00</option>
                        <option>14:00 - 15:00</option><option>15:00 - 16:00</option>
                    </select>
                </div>
            </div>

            <div class="mt-3">
                <label> Ghi chú</label>
                <textarea asp-for="Note" class="form-control"></textarea>
            </div>

            <div class="mt-3">
                <label> Căn Cước Công Dân</label>
                <input type="file" name="cccdFile" class="form-control" />
            </div>

            <div class="mt-3">
                <label>Bằng lái xe của bạn</label>
                <input type="file" name="licenseFile" class="form-control" />
            </div>

            <button type="submit" class="btn-submit mt-4">
                 Đăng ký ngay
            </button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script src="~/js/testdrive.js"></script>