@model List<ToyotaWeb.Models.Car>

@{
    ViewData["Title"] = "Trang chủ";
}

<link rel="stylesheet" href="~/css/home.css" />
@if (TempData["success"] != null)
{
    <div class="alert success-alert">
        @TempData["success"]
    </div>
}
<!-- ===== BANNER ===== -->
<section class="banner">
    <div class="slider">

        <div class="slide active">
            <img src="~/images/banner/trangchu.jpg" />
            <div class="banner-content">
                <h1>VẬN ĐỘNG BỨT PHÁ</h1>
                <p>Khám phá dòng xe Toyota mới nhất</p>
            </div>
        </div>

        <div class="slide">
            <img src="~/images/banner/trangchu2.png" />
            <div class="banner-content">
                <h1>ƯU ĐÃI ĐẦU NĂM</h1>
                <p>Trả trước 0đ - Lãi suất hấp dẫn</p>
            </div>
        </div>

    </div>
</section>

<!-- ===== SEARCH ===== -->
<section class="filter-box">
    <form method="get" asp-controller="Car" asp-action="Index">

        <select name="bodyType">
            <option value="">Kiểu dáng</option>
            <option value="Sedan">Sedan</option>
            <option value="SUV">SUV</option>
            <option value="MPV">MPV</option>
            <option value="Pickup">Pickup</option>
        </select>

        <select name="seats">
            <option value="">Số chỗ</option>
            <option value="5">5 chỗ</option>
            <option value="7">7 chỗ</option>
        </select>

        <select name="fuelType">
            <option value="">Nhiên liệu</option>
            <option value="Xăng">Xăng</option>
            <option value="Dầu">Dầu</option>
            <option value="Hybrid">Hybrid</option>
        </select>

        <select name="origin">
            <option value="">Xuất xứ</option>
            <option value="Việt Nam">Việt Nam</option>
            <option value="Thái Lan">Thái Lan</option>
            <option value="Indonesia">Indonesia</option>
            <option value="Nhật Bản">Nhật Bản</option>
        </select>

        <button type="submit">Tìm xe</button>
    </form>
</section>

<!-- ===== SHOWROOM ===== -->
<section class="car-showroom">

    <h2 class="title">KHÁM PHÁ CÁC DÒNG XE TOYOTA</h2>

    <div class="car-tabs">
        <span class="active" data-type="">Tất cả</span>
        <span data-type="SUV">SUV</span>
        <span data-type="Sedan">Sedan</span>
        <span data-type="MPV">Đa dụng</span>
        <span data-type="Pickup">Bán tải</span>
    </div>

    <div class="car-list-new">
        @foreach (var car in Model)
        {
            var thumbnail = car.CarImages?.FirstOrDefault()?.ImageUrl;

            <div class="car-item" data-type="@car.BodyType">
                <a asp-controller="Car"
                   asp-action="Details"
                   asp-route-slug="@car.Slug">

                    <img src="@(thumbnail != null 
                                ? Url.Content("~/images/cars/" + thumbnail) 
                                : Url.Content("~/images/no-image.jpg"))" /><h3>@car.Name</h3>
                    <p>Chỉ từ @car.Price.ToString("N0") VND</p>
                </a>
            </div>
        }
    </div>

</section>

<!-- ===== JS ===== -->
<script>
document.addEventListener("DOMContentLoaded", function () {

    // slider
    let slides = document.querySelectorAll(".slide");
    let index = 0;

    setInterval(() => {
        slides[index].classList.remove("active");
        index = (index + 1) % slides.length;
        slides[index].classList.add("active");
    }, 3000);

    // filter tab
    document.querySelectorAll(".car-tabs span").forEach(tab => {
        tab.onclick = () => {

            document.querySelectorAll(".car-tabs span")
                .forEach(t => t.classList.remove("active"));

            tab.classList.add("active");

            let type = tab.dataset.type;

            document.querySelectorAll(".car-item").forEach(item => {
                if (!type || item.dataset.type === type) {
                    item.style.display = "block";
                } else {
                    item.style.display = "none";
                }
            });
        }
    });

});
</script>