@model ToyotaWeb.Models.Sale

@{
    ViewData["Title"] = "Nhân viên tư vấn";
}

<!-- HERO BANNER -->
<section class="sale-hero">

    <div class="sale-hero-content">

        <h1>@Model.Name</h1>

        <p>Chuyên viên tư vấn Toyota</p>

        <a href="tel:@Model.Phone" class="btn btn-danger btn-lg">
            📞 Gọi ngay
        </a>

    </div>

</section>


<!-- ABOUT SALE -->
<section class="sale-about container">

    <div class="row align-items-center">

        <div class="col-md-5">

            <img src="~/images/sales/@Model.Image"
                 class="img-fluid rounded shadow">

        </div>

        <div class="col-md-7">

            <h2>Xin chào, tôi là @Model.Name</h2>

            <p>
                Tôi là chuyên viên tư vấn xe Toyota với nhiều năm kinh nghiệm
                trong lĩnh vực tư vấn và hỗ trợ khách hàng lựa chọn chiếc xe
                phù hợp nhất với nhu cầu và ngân sách.
            </p>

            <p>
                Tôi luôn sẵn sàng hỗ trợ bạn về:
            </p>

            <ul>
                <li>Tư vấn chọn xe phù hợp</li>
                <li>Báo giá chi tiết</li>
                <li>Hỗ trợ trả góp ngân hàng</li>
                <li>Đăng ký lái thử xe</li>
            </ul>

            <div class="mt-3">

                <a href="tel:@Model.Phone" class="btn btn-danger">
                    📞 Gọi ngay
                </a>

                <a href="https://zalo.me/@Model.Phone"
                   class="btn btn-success">
                    💬 Chat Zalo
                </a>

            </div>

        </div>

    </div>

</section>


<!-- WHY CHOOSE ME -->
<section class="sale-features text-center">

    <h2>Vì sao nên chọn tôi?</h2>

    <div class="container">

        <div class="row mt-5">

            <div class="col-md-4">

                <i class="fa-solid fa-car fa-3x text-danger"></i>

                <h5 class="mt-3">Nhiều dòng xe</h5>

                <p>
                    Tư vấn đầy đủ các dòng xe Toyota mới nhất.
                </p>

            </div>


            <div class="col-md-4">

                <i class="fa-solid fa-handshake fa-3x text-danger"></i>

                <h5 class="mt-3">Tư vấn tận tâm</h5>

                <p>
                    Luôn hỗ trợ khách hàng nhanh chóng và chuyên nghiệp.
                </p>

            </div>


            <div class="col-md-4">

                <i class="fa-solid fa-star fa-3x text-danger"></i>

                <h5 class="mt-3">Khách hàng hài lòng</h5>

                <p>
                    Hàng trăm khách hàng đã mua xe và hài lòng với dịch vụ.
                </p>

            </div>

        </div>

    </div>

</section>