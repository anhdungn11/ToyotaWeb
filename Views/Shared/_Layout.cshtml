<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Toyota</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

<body>

<header>
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
<div class="container">

<a class="navbar-brand" href="/">
    <b>TOYOTA Bình Dương</b>
</a>

<!-- 🔥 LOGIN HIỂN THỊ -->
@if (User.Identity.IsAuthenticated)
{
    <span class="me-2">@User.Identity.Name</span>
    <a href="/Account/Logout" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
}
else
{
    <a href="/Account/Login" class="btn btn-outline-primary btn-sm">Đăng nhập</a>
}

<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
<span class="navbar-toggler-icon"></span>
</button>

<div class="collapse navbar-collapse" id="navbarNav">
<ul class="navbar-nav ms-auto align-items-center">

<li class="nav-item">
    <a class="nav-link" href="/">Trang chủ</a>
</li>

@* <li class="nav-item">
    <a class="nav-link" href="/Sale">Nhân viên tư vấn</a>
</li> *@

<li class="nav-item ms-3">
    <div onclick="goToMap()"
         style="display:flex;align-items:center;gap:8px;background:#f1f5f9;padding:5px 10px;border-radius:20px;cursor:pointer;">
        <i class="fa-solid fa-location-dot" style="color:#e60000;"></i>
        <span style="font-size:14px;">Map</span>
    </div>
</li>

</ul>
</div>

</div>
</nav>
</header>

<main class="mt-4">
    @RenderBody()
</main>

<partial name="_Footer" />

<section class="contact-section text-center py-5">
    <h2 class="mb-4">TRAO ĐỔI VỚI CHÚNG TÔI</h2>

    <div class="contact-phone mb-4">
        <i class="fa-solid fa-phone"></i> 1800 1524
        <span class="mx-3">|</span>
        <i class="fa-solid fa-phone"></i> 0384508388
    </div>
</section>

<!-- ================= CHAT ================= -->
<div id="chat-toggle">
    <i class="fa-solid fa-comment"></i>
</div>

<div id="chat-box">
    <div class="chat-header">
        🚗 Toyota AI
        <span onclick="toggleChat()">✖</span>
    </div>

    <div id="chat-body">
        <div class="bot-msg">Chào bạn! Bạn cần hỗ trợ gì?</div>
    </div>

    <div class="chat-input">
        <input type="text" id="msg" placeholder="Nhập câu hỏi..." />
        <button onclick="sendMsg()">Gửi</button>
    </div>
</div>

<style>
#chat-toggle {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #e60000;
    color: white;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;cursor: pointer;
}

#chat-box {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 320px;
    height: 420px;
    background: white;
    border-radius: 12px;
    display: none;
    flex-direction: column;
}
</style>

<!-- 🔥🔥🔥 QUAN TRỌNG NHẤT -->
<!-- jQuery PHẢI LOAD TRƯỚC -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Validation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<!-- Bootstrap -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@RenderSection("Scripts", required: false)

<script>
function toggleChat() {
    let box = document.getElementById("chat-box");
    box.style.display = (box.style.display === "flex") ? "none" : "flex";
}

async function sendMsg() {
    let input = document.getElementById("msg");
    let message = input.value.trim();
    if (!message) return;

    let chatBody = document.getElementById("chat-body");
    chatBody.innerHTML += `<div class="user-msg">${message}</div>`;
    input.value = "";

    let res = await fetch("/Chat/Ask", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: "message=" + encodeURIComponent(message)
    });

    let data = await res.json();
    chatBody.innerHTML += `<div class="bot-msg">${data.reply}</div>`;
}

function goToMap() {
    window.location.href = "/Map";
}
</script>

</body>
</html>